# Self-hosted Anki sync server the bridge syncs against.
# These are the sync server's own credentials, unrelated to any AnkiWeb account.
ANKI_SYNC_URL=http://100.64.0.2:8080/
ANKI_SYNC_USER=your-sync-user
ANKI_SYNC_PASS=your-sync-password

# Where to read note media (audio/video) from for playback. The bridge does not
# sync media itself; point this at an existing store — normally the sync server's
# own media folder, which is on the same machine.
ANKI_MEDIA_DIR=/path/to/anki-sync-server/data/<user>/media
